extends layouts/rootView

block content 
    h3.mt-5.text-center Assets Master 

    .d-flex.justify-content-end.mb-3 

    //- Filter Dropdown
    .row.mb-4 
        .col-md-3.mb-3 
            label.form-label(for="filterEmployee")
                b Filter by Employee
            select.form-control.employeeName#filterEmployee
                option(value="") Select 
        .col-md-3.mb-3
            label.form-label(for="filterAsset")
                b Filter by Asset
            select.form-control.selectAsset#filterAsset
                option(value="") Select 
        .col-md-3.mb-3
            label.form-label(for="filterCategory")
                b Filter by Category
            select.form-control.category#filterCategory
                option(value="") Select 
        .col-md-3.d-flex.align-items-center.mt-3
            button.btn.btn-primary.me-2(type="button" onclick="applyFilters()") Search 
            button.btn.btn-success(data-bs-toggle="modal" data-bs-target="#addNewAssetModel")
                | + Issue Asset 

        table#assetTable.table.table-bordered.table-striped 
            thead 
                tr 
                    th ID 
                    th Employee Name  
                    th Brand
                    th Model
                    th Category
                    th Issued Date
                    th Remark 
                    th Actions
            tbody 
                if !assetsList || assetsList.length === 0
                    tr 
                        td(colspan="8")
                            p.text-center No Assets Found.
                else 
                    each items in assetsList 
                        tr 
                            td #{items.id}
                            td #{items.employeeName} 
                            td #{items.brand} 
                            td #{items.model}
                            td #{items.category_name}
                            td #{items.issued_date}
                            td #{items.remark} 
                            td 
                                button.btn.btn-sm.btn-primary Edit 
                                button.btn.btn-sm.btn-danger.ms-1 Delete 


        // Update Asset Modal
        .modal.fade#addNewAssetModel(tabindex="1" aria-labelledby="addNewAssetModalLabel" aria-hidden="true")
            .modal-dialog.modal-lg 
                .modal-content 
                    .modal-header 
                        h5.modal-title#addNewAssetModalLabel Edit Issued Asset 
                        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close" onclick="resetForm()")
                    .modal-body 
                        form#addAssetForm(onsubmit="event.preventDefault(); createOrUpdateAsset();")
                            .row 
                                .col-md-6.mb-3 
                                    label.form-label(for="employeeName") Employee Name 
                                    select.form-control.employeeName#employeeName(autocomplete="off" required)
                                        option(value="") Select Employee 
                                .col-md-6.mb-3 
                                    label.form-label(for="selectAsset") Select Asset 
                                    select.form-control.selectAsset#selectAsset(autocomplete="off" required)
                                        option(value="") Assign Asset 
                                .col-md-6.mb-3 
                                    label.form-label(for="issueDate") Issue Date 
                                    input.form-control#issueDate(type="date" autocomplete="off" required)
                                .col-md-6.mb-3 
                                    label.form-label(for="remark") Remark 
                                    input.form-control#remark(type="text" autocomplete="off" required)
                    .modal-footer 
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal" onclick="resetForm()") Close 
                        button.btn.btn-primary(type="submit" form="addAssetForm") Save Changes 

                // Delete Confirmation Modal
        .modal.fade#deleteConfirmModal(tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true")
            .modal-dialog
                .modal-content
                    .modal-header
                        h5.modal-title#deleteConfirmModalLabel Delete Asset Issue
                        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                    .modal-body
                        p Are you sure you want to delete this asset issue?
                        .form-group
                            label.form-label(for="deleteRemark") Remark
                            input.form-control#deleteRemark(type="text" placeholder="Enter remark for deletion" required)
                        input(type="hidden")#deleteAssetId
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                        button.btn.btn-danger#confirmDeleteBtn(type="button") Delete
    
    script. 
        function resetForm() {
            document.getElementById("addAssetForm").reset();
            // Remove the editAssetId input if it exists
            const editAssetIdInput = document.getElementById('editAssetId');
            if (editAssetIdInput) {
                editAssetIdInput.remove();
            }
        }

        // function for fetch assets 
        async function fetchAssets(asset_id, category_id='', employee_id='') {
            try {
                let url = '/assetProvide/fetch';

                if (asset_id) {
                    url += `?asset_id=${asset_id}`;
                }

                if (category_id) {
                    url += `?category_id=${category_id}`;
                }

                if (employee_id) {
                    url += `${url.includes('?') ? '&' : '?'}employee_id=${employee_id}`; 
                }

                const assetsFetchResponse = await fetch(url);
                if (assetsFetchResponse.ok) {
                    const assetsData = await assetsFetchResponse.json();
                    
                    const tbody = document.querySelector('#assetTable tbody');
                    
                    // Clear existing DataTable if it exists
                    if ($.fn.DataTable.isDataTable('#assetTable')) {
                        $('#assetTable').DataTable().destroy();
                    }
                    
                    // Clear the table body
                    tbody.innerHTML = '';
                    
                    // Populate the table with data
                    if (assetsData && assetsData.length > 0) {
                        assetsData.forEach(items => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td>${items.id || ''}</td>
                                <td>${items.employeeName || '-'}</td>
                                <td>${items.brand || '-'}</td>
                                <td>${items.model || '-'}</td>
                                <td>${items.category_name || '-'}</td>
                                <td>${items.issued_date ? new Date(items.issued_date).toLocaleDateString() : '-'}</td>
                                <td>${items.remark || '-'}</td> 
                                <td>
                                    <button class="btn btn-sm btn-primary" onclick="editAsset(${items.id})">Edit</button>
                                    <button class="btn btn-sm btn-danger ms-1" onclick="deleteAsset(${items.id})">Delete</button>
                                </td>
                            `;
                            tbody.appendChild(row);
                        });
                    }                 
                                        
                } else {
                    console.error('Failed to fetch Assets');
                }
            } catch (error) {
                console.error('Error fetching assets:', error);
            }
            $('#assetTable').DataTable();
        }

        // create or update asset
        async function createOrUpdateAsset() {
            try {
                const form = document.getElementById('addAssetForm');
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                const asset_id = document.getElementById('selectAsset').value;
                const employee_id = document.getElementById('employeeName').value;
                const issued_date = document.getElementById('issueDate').value;
                const remark = document.getElementById('remark').value;
                const assetId = document.getElementById('editAssetId') ? document.getElementById('editAssetId').value : null;

                const url = assetId ? `/assetProvide/update` : '/assetProvide/assetIssue';
                const method = 'POST';

                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        asset_id,
                        employee_id,
                        issued_date,
                        remark,
                        id: assetId
                    })
                });

                if (response.ok) {
                    $('#addNewAssetModel').modal('hide');
                    resetForm();
                    fetchAssets();
                    alert(assetId ? 'Asset assignment updated successfully' : 'Asset issued successfully');
                } else {
                    const errorText = await response.text();
                    console.error('Failed to issue asset:', errorText);
                    alert('Failed to issue asset: ' + errorText);
                }
            } catch (error) {
                console.error('Error issuing asset:', error);
                alert('Error issuing asset: ' + error.message);
            }
        }

        // edit asset
        async function editAsset(assetId) {
            try {
                const response = await fetch(`/assetProvide/fetch?id=${assetId}`);

                if (response.ok) {
                    const assetData = await response.json();

                    if (!assetData) {
                        throw new Error('No asset data received');
                    }

                    document.getElementById('selectAsset').value = assetData.asset_id || '';
                    document.getElementById('employeeName').value = assetData.user_id || '';
                    document.getElementById('remark').value = assetData.remark || '';
                    
                    // Format the date for the date input (YYYY-MM-DD)
                    if (assetData.issued_date) {
                        const date = new Date(assetData.issued_date);
                        const formattedDate = date.toISOString().split('T')[0];
                        document.getElementById('issueDate').value = formattedDate;
                    }
                    
                    let editAssetIdInput = document.getElementById('editAssetId');
                    if (!editAssetIdInput) {
                        editAssetIdInput = document.createElement('input');
                        editAssetIdInput.type = 'hidden';
                        editAssetIdInput.id = 'editAssetId';
                        document.getElementById('addAssetForm').appendChild(editAssetIdInput);
                    }
                    editAssetIdInput.value = assetId;

                    $('#addNewAssetModel').modal('show');
                } else {
                    const errorText = await response.text();
                    console.error('Failed to fetch asset data. Status:', response.status, 'Error:', errorText);
                    alert('Failed to fetch asset data');
                }
            } catch (error) {
                console.error('Error in editAsset function:', error.message);
                console.error('Full error:', error);
                alert('Error fetching asset data: ' + error.message);
            }
        }

        // delete asset
        function deleteAsset(assetId) {
            // Set the asset ID in the hidden field
            document.getElementById('deleteAssetId').value = assetId;
            
            // Clear any previous remark
            document.getElementById('deleteRemark').value = '';
            
            // Show the delete confirmation modal
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            deleteModal.show();
        }

        // Handle delete confirmation
        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            const assetId = document.getElementById('deleteAssetId').value;
            const remarkText = document.getElementById('deleteRemark').value;
            
            if (!remarkText.trim()) {
                alert('Please enter a remark for deletion');
                return;
            }
            
            try {
                const response = await fetch(`/assetProvide/delete`, {
                    method: 'post',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        id: assetId,
                        remark: remarkText 
                    }),
                }); 

                if (response.ok) {
                    // Hide the modal
                    bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal')).hide();
                    
                    console.log('Asset Issue deleted successfully');
                    fetchAssets();
                    alert('Asset Issue deleted successfully'); 
                } else {
                    const errorText = await response.text();
                    console.error('Failed to delete asset:', errorText);
                    alert('Failed to delete asset Issue: ' + errorText);
                }
            } catch (error) {
                console.error('Error deleting asset:', error);
                alert('Error deleting asset issue: ' + error.message);
            }
        });

        // DOMContentLoaded event
        document.addEventListener('DOMContentLoaded', async function() {
            console.log("DOM fully loaded");
            try {
                await fetchAssets();
                
                // Remove this line as we don't need it
                // handleFilterVisibility();
                
                // Fetch categories
                const categoryResponse = await fetch('/assets/categoriesAndStatus');
                if (categoryResponse.ok) {
                    const data = await categoryResponse.json();
                    const categorySelects = document.querySelectorAll('.category');

                    categorySelects.forEach(every => {
                        while (every.options.length > 1) {
                            every.remove(1);
                        }

                        if (data.assetCategory && Array.isArray(data.assetCategory)) {
                            data.assetCategory.forEach(item => {
                                const option = document.createElement('option');
                                option.value = item.id;
                                option.textContent = item.name;
                                every.appendChild(option);
                            });
                        }
                    });
                } else {
                    console.error('Failed to fetch categories');
                }

                // Fetch employee list for filter
                const employeeResponse = await fetch('/common/getEmployeeList');
                if (employeeResponse.ok) {
                    const employeeData = await employeeResponse.json();
                    const employeeSelects = document.querySelectorAll('.employeeName');
                    
                    employeeSelects.forEach(select => {
                        if (employeeData && Array.isArray(employeeData)) {
                            employeeData.forEach(employee => {
                                const option = document.createElement('option');
                                option.value = employee.emp_id;
                                option.textContent = employee.emp_name;
                                select.appendChild(option);
                            });
                        }
                    });
                } else {
                    console.error('Failed to fetch employee list');
                }

                // Fetch asset list for filter
                const assetResponse = await fetch('/common/getAssetList');
                if (assetResponse.ok) {
                    const assetData = await assetResponse.json();
                    const assetSelects = document.querySelectorAll('.selectAsset');
                    
                    assetSelects.forEach(select => {
                        if (assetData && Array.isArray(assetData)) {
                            assetData.forEach(asset => {
                                const option = document.createElement('option');
                                option.value = asset.value;
                                option.textContent = asset.label;
                                select.appendChild(option);
                            });
                        }
                    });
                } else {
                    console.error('Failed to fetch asset list');
                }
            } catch (error) {
                console.error('Error fetching Data:', error);
            }
        });



